          (net pbl (joined
              (portRef b_last (instanceRef mux))
              (portRef m_last (instanceRef pb))
            )
          )
          (net pbr (joined
              (portRef b_ready (instanceRef mux))
              (portRef m_ready (instanceRef pb))
            )
          )
        )
      )
    )
  )
  (design pam3_analyzer_core
    (cellRef pam3_analyzer_core (libraryRef DESIGN))
  )
)
